#!/bin/sh
# Before each push: run every check the CI workflow runs, so a red CI run is caught here first.
# Set SUREQ_SKIP_PREPUSH=1 only in an emergency; CI still runs on GitHub.
[ "$SUREQ_SKIP_PREPUSH" = "1" ] && exit 0

# Git passes one line per pushed ref: "<local ref> <local sha> <remote ref> <remote sha>". A push that
# sends no new commits skips the checks: tags only (a release tag on a commit already on main and tested),
# deletions (an all-zero local sha), or nothing at all (an up-to-date push).
sends_commits=0
while read -r _local_ref local_sha remote_ref _remote_sha; do
  case "$remote_ref" in refs/tags/*) continue ;; esac
  case "$local_sha" in *[!0]*) sends_commits=1 ;; esac
done
[ "$sends_commits" = "0" ] && exit 0

exec sh scripts/ci-local.sh
